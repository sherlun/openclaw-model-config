{
  "name": "openclaw-model-config",
  "version": "1.0.0",
  "description": "OpenClaw Model Config",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "node dev.js",
    "build": "vite build",
    "start": "node server.js",
    "electron": "electron .",
    "electron-dev": "concurrently \"vite\" \"node server.js\" \"electron .\"",
    "pack": "node pack.js",
    "pack:portable": "node pack.js portable",
    "pack:installer": "node pack.js nsis",
    "zip": "powershell -ExecutionPolicy Bypass -File scripts/zip-release.ps1"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0",
    "concurrently": "^9.0.0"
  },
  "build": {
    "appId": "com.openclaw.modelconfig",
    "productName": "OpenClaw Model Config",
    "electronVersion": "28.3.3",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "server.js",
      "icon.png",
      "build-icon.png",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-icon.ico"
    },
    "portable": {
      "artifactName": "OpenClaw-Model-Config-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build-icon.ico",
      "uninstallerIcon": "build-icon.ico",
      "installerHeaderIcon": "build-icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenClaw Model Config"
    }
  }
}
